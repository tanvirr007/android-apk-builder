---
import BaseLayout from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { icon } from '../components/icons';

const title = 'Home';
const description =
  'Build Android APK and AAB files from Command Prompt or PowerShell on Windows 10 and 11 without Android Studio.';

const features = [
  'Reads Groovy, Kotlin DSL, and version catalog build files to identify required SDK, build-tools, and AGP versions.',
  'Resolves JDK, Gradle, and AGP versions against an integrated compatibility matrix.',
  'Profiles host RAM and applies matching JVM heap limits, garbage collection options, and worker counts to prevent out-of-memory errors on 4 GB systems.',
  'Installs missing JDKs and SDK packages, and restores damaged Gradle wrappers.',
  'Signs release builds, generates a keystore when none exists, and verifies outputs with SHA-256 hashes and apksigner v1 through v4 checks.',
  'Scopes environment variables to the active session and copies build artifacts instead of moving them.',
];
---
<BaseLayout title={title} description={description} wide>
  <div class="page-head">
    <h1>Build Android APKs without Android Studio</h1>
    <p class="lead">
      Android APK Builder compiles Kotlin, Java, and Jetpack Compose projects
      from Command Prompt or PowerShell on Windows 10 and 11.
    </p>
  </div>

  <p>
    The tool pairs a PowerShell engine with a <code>build.bat</code> launcher.
    It inspects your project, selects the required JDK and Gradle versions,
    prepares the Android SDK, compiles the project, signs release binaries, and
    copies outputs into <code>dist</code>. While Android Studio consumes 4 GB to
    8 GB of RAM at idle, this engine runs in the terminal and tunes memory usage
    to host hardware.
  </p>

  <h2>What the engine does automatically</h2>
  <ul class="feature-grid">
    {features.map((feat) => (
      <li class="feature-item">
        <span set:html={icon('check')} />
        <span>{feat}</span>
      </li>
    ))}
  </ul>

  <h2>Try it in two commands</h2>
  <div class="cmd-grid">
    <CodeBlock
      caption="Clone"
      code={`git clone https://github.com/tanvirr007/android-apk-builder.git`}
    />
    <CodeBlock
      caption="Open directory"
      code={`cd android-apk-builder`}
    />
  </div>

  <p>
    Double-click <code>build.bat</code>, or right-click and choose <strong>Run as administrator</strong> if required.
    The interactive wizard prompts for your Android project path. Type or paste the path, or drag and drop your project folder into the window to build.
  </p>

  <p>
    The <a href="/how-to-use">How to use</a> page documents available modes,
    command-line flags, release signing, and memory configurations.
  </p>
</BaseLayout>
