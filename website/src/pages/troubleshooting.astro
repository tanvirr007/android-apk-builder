---
import BaseLayout from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { icon } from '../components/icons';

const title = 'Troubleshooting';
const description =
  'Solutions for common Android APK Builder errors, covering PowerShell execution policy, memory limits, SDK configuration, release signing, JDK versions, and Gradle wrappers.';

const issues: { error: string; cause: string; remedy: string; code?: string; extra?: string }[] = [
  {
    error: 'Running scripts is disabled on this system',
    cause: 'Windows sets the default PowerShell execution policy to Restricted, which prevents scripts from running.',
    remedy: 'Running build.bat bypasses this restriction automatically. If you run setup-windows.ps1 directly, set the execution policy for your active session:',
    code: 'Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force',
  },
  {
    error: 'java.lang.OutOfMemoryError: Java heap space',
    cause: 'The Gradle process exceeds available physical RAM, forcing Windows to page heavily to disk and slowing down the build.',
    remedy: 'Apply the low-memory profile to cap heap usage and disable background daemons:',
    code: 'build.bat -BuildType Release -ForceLowMem',
  },
  {
    error: 'SDK location not found',
    cause: 'Gradle cannot locate the Android SDK, or local.properties contains unescaped Windows backslashes, which properties syntax treats as escape characters.',
    remedy: 'The engine formats sdk.dir with forward slashes, such as sdk.dir=C:/Android, and preserves the rest of the file. If you edit local.properties manually, format paths with forward slashes or escaped backslashes, such as sdk.dir=C:\\\\Android.',
  },
  {
    error: 'Release build failed: signingConfig is not configured',
    cause: 'The project defines a release build type without signing credentials, and no fallback is present.',
    remedy: 'Build the debug variant to sign with the default debug certificate:',
    code: 'build.bat -BuildType Debug',
    extra: 'Alternatively, configure release signing in the module build file. The engine injects signing settings automatically when a keystore is specified:',
  },
  {
    error: "Failed to find target with hash string 'android-XX'",
    cause: 'The required Android SDK platform package is not installed locally.',
    remedy: 'Allow the engine to install missing platforms without passing -SkipSdkInstall, and accept the SDK licenses. To pin a specific platform version:',
    code: 'build.bat -CompileSdkOverride 34 -AcceptLicenses',
  },
  {
    error: 'Unsupported class file major version',
    cause: 'The selected JDK version is incompatible with the project Android Gradle Plugin or Gradle version.',
    remedy: 'The engine checks compatibility requirements before compiling. If the host has multiple JDK installations and selects an unintended one, pass the path directly:',
    code: 'build.bat -JdkPath "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.10.7-hotspot"',
  },
  {
    error: 'Gradle wrapper missing or corrupted',
    cause: 'The project is missing gradle/wrapper/gradle-wrapper.jar, or the wrapper file is empty.',
    remedy: 'The engine detects missing or invalid wrapper archives, downloads a matching Gradle distribution based on the AGP version, and regenerates the wrapper files automatically.',
  },
  {
    error: 'Android SDK license agreement not accepted',
    cause: 'Android SDK components cannot download until the Google license terms are accepted.',
    remedy: 'Pass the acceptance switch to accept all licenses non-interactively:',
    code: 'build.bat -AcceptLicenses',
  },
];
---
<BaseLayout title={title} description={description} wide>
  <div class="page-head">
    <h1>Troubleshooting</h1>
    <p class="lead">
      Solutions for the eight most common build failures. Match the error text
      from your build log, then apply the fix.
    </p>
  </div>

  <div class="faq">
    {issues.map((issue) => (
      <details data-faq>
        <summary><span class="faq-caret" set:html={icon('chevron')} />{issue.error}</summary>
        <div class="faq-body">
          <div class="faq-body-grid">
            <div class="faq-col">
              <span data-label>Cause</span>
              <p>{issue.cause}</p>
            </div>
            <div class="faq-col">
              <span data-label>Remedy</span>
              <p>{issue.remedy}</p>
              {issue.code && <CodeBlock code={issue.code} />}
              {issue.extra && <p>{issue.extra}</p>}
            </div>
            {issue.error.startsWith('Release build failed') && (
              <div class="faq-col-full">
                <CodeBlock
                  caption="Module build.gradle.kts, release signing"
                  code={`android {\n    signingConfigs {\n        create("release") {\n            storeFile = file("my-release-key.jks")\n            storePassword = "password"\n            keyAlias = "my-alias"\n            keyPassword = "password"\n        }\n    }\n    buildTypes {\n        release {\n            signingConfig = signingConfigs.getByName("release")\n        }\n    }\n}`}
                />
              </div>
            )}
          </div>
        </div>
      </details>
    ))}
  </div>

  <p>
    If your error is not listed, run the build with <code>-VerboseLog</code> and
    <a href="https://github.com/tanvirr007/android-apk-builder/issues/new?template=bug_report.yml" target="_blank" rel="noopener noreferrer">open a bug report on GitHub</a>
    with the output attached.
  </p>
</BaseLayout>
